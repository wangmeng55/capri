# Copy to the service environment file and replace the example values.
# Never commit a populated secrets file.

# Required public browser settings
FE_TOKEN=
REQUIRE_FE_TOKEN=1
SHELL_ORIGIN=https://console.example.com
HOSTS_DOMAIN=hosts.example.com

# QUIC host tunnel. Use a real certificate when available; otherwise allow
# the host's pinned/self-signed tunnel certificate.
QUIC_ALLOW_SELF_SIGNED=1
# QUIC_CERT=/etc/capri-hub/fullchain.pem
# QUIC_KEY=/etc/capri-hub/privkey.pem

# Optional listener and logging settings
PORT=8787
QUIC_PORT=8788
TZ=Asia/Shanghai
# CORS_ORIGINS=https://console.example.com
